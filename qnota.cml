Domain QNota {}

BoundedContext QNota implements QNota {

    Aggregate Responsavel {
        Entity Responsavel {
            aggregateRoot

            -ResponsavelId id
            String nome
            String cpf
            String enderecoEletronico
            - Status status

            def void atribuirIdSeAusente(@ResponsavelId novoId);
            def void renomear(String novoNome);
            def void alterarEmail(String novoEnderecoEletronico);
            def void marcarInadimplente();
            def void regularizar();
            def void inativar();
            def boolean validarCpf(String cpf);
            def boolean formatoCpfValido(String cpf);
            def int calcularDigitoVerificador(String cpf, int posicao);
            

            Repository ResponsavelRepository {
                void salvar(@Responsavel r);

                @Responsavel porId(@ResponsavelId id);

                boolean cpfExiste(String cpf);

                void atualizarContato(@ResponsavelId id, String novoNome, String novoEnderecoEletronico); 
                void excluir(@ResponsavelId id);

                boolean estaVinculadoAAlgumAluno(@ResponsavelId id);
                boolean estaInadimplente(@ResponsavelId id);
            }
        }

        ValueObject ResponsavelId {
            int id
        }

        Service ResponsavelService {
            @ResponsavelId cadastrar(String nome, String cpf, String enderecoEletronico);
            void atualizarContato(@ResponsavelId id, String novoNome, String novoEnderecoEletronico);
            void marcarInadimplente(@ResponsavelId id);
            void regularizar(@ResponsavelId id);
            void inativar(@ResponsavelId id);
            void excluir(@ResponsavelId id);
            void vincularAoAluno(@ResponsavelId responsavelId, @AlunoId alunoId, boolean principal);
            void desvincularDoAluno(@ResponsavelId responsavelId, @AlunoId alunoId);
            
        }

        enum Status {
			ATIVO, 
            INADIMPLENTE, 
            INATIVO			
		}
    }

    Aggregate Coordenador {

        ValueObject CoordenadorId{
            int id;
        }

        Entity Coordenador {
            aggregateRoot

            String nome;
            String enderecoEletronico;
            String senhaHash;
            boolean ativo;
            -CoordenadorId id

            def void atribuirIdSeAusente(@CoordenadorId novoId);
            def void renomear(String novoNome);
            def void alterarEmail(String novoEmail);
            def void alterarSenhaHash(String novoHash);
            def void ativar();
            def void inativar();

            Repository CoordenadorRepository {
                @CoordenadorId salvar(@Coordenador c);

                @Coordenador porId(@CoordenadorId id);
    			Optional<@Coordenador> porEmail(String enderecoEletronico);

                boolean emailExiste(String enderecoEletronico);

                void excluir(@CoordenadorId id);
            }
        }


        Service CoordenadorService {
            @CoordenadorId cadastrar(String nome, String enderecoEletronico, String senhaPlano);

            @CoordenadorId autenticar(String enderecoEletronico, String senhaPlano);

            void alterarSenha(@CoordenadorId id, String senhaAtual, String novaSenha);

            void atualizarContato(@CoordenadorId id, String novoNome, String novoEnderecoEletronico);

            void inativar(@CoordenadorId id);
            void ativar(@CoordenadorId id);
            void excluir(@CoordenadorId id);
        }
        
        Service HashService {
        	String hash(String rawPassword);
    		boolean matches(String rawPassword, String hashedPassword);
        }
    }

    Aggregate Aluno {

        ValueObject AlunoId {
            int id
        }

        ValueObject AlunoResponsavel {
        	-ResponsavelId responsavel
        	boolean principal
        }

        Entity Aluno {
            aggregateRoot

            -AlunoId id
            String nome
            LocalDate dataNascimento
            boolean ativo
            -TurmaId id
            -List<AlunoResponsavel> vinculos
            
            def Map<String, NotaDoAluno> notas;
            def void atribuirIdSeAusente(@AlunoId novoId);

            def void inativar();
            def void ativar();

            def void mudarTurma(@TurmaId novaTurma);

            def void substituirResponsaveis(List<@ResponsavelId> novaLista, @ResponsavelId novoPrincipal);
            def void adicionarResponsavel(@ResponsavelId idResp, boolean principal);
            def void removerResponsavel(@ResponsavelId idResp);
            def void adicionarNota(@SimuladoId simuladoId, @DisciplinaId disciplinaId, double valor);
            

            Repository AlunoRepository {
                @AlunoId salvar(@Aluno aluno);

                @Aluno porId(@AlunoId id);
                void remover(@AlunoId id);

                boolean existeOutroComMesmoNomeENascimentoNaTurma(String nome, LocalDate data, @TurmaId turmaId);
                int contarResponsaveis(@AlunoId id);
                boolean existeVinculo(@AlunoId id);

                List<@Aluno> porTurma(@TurmaId turmaId);

                boolean temNotasPendentesEmSimuladosEmEdicao(@AlunoId alunoId);
                boolean temNotas(@AlunoId alunoId);

                boolean existeNotaParaSimulado(@SimuladoId simuladoId);

                boolean possuiSimuladoFinalizado(@AlunoId alunoId);

                void alterarTurma(@AlunoId alunoId, @TurmaId novaTurmaId);
            }
        }
        
        Entity NotaDoAluno {
        	-SimuladoId simuladoId
        	-DisciplinaId disciplinaId
        	double valor
        	LocalDateTime dataLancamento
        	-List<Justificativa> justificativas
        	
        	def @NotaDoAluno adicionarJustificativa(@Justificativa novaJustificativa);
        	def @NotaDoAluno alterarValor(double novoValor);
        	def boolean temJustificativas();
        	def int quantidadeJustificativas();
        	
        }

        ValueObject Justificativa {
        	String notaId
        	double notaAnterior
        	double notaCorrigida
        	String texto
        	LocalDateTime dataHora
        	-ProfessorId professor
        	
        }

        Service AlunoService {
            
            @AlunoId cadastrar(String nome, LocalDate nascimento, @TurmaId turma, List<@ResponsavelId> responsaveis,@ResponsavelId principal);

            void transferir(@AlunoId id, @TurmaId novaTurma);

            void inativar(@AlunoId id);

            void excluir(@AlunoId id);

            void vincularResponsavel(@AlunoId id, @ResponsavelId resp, boolean principal);
            void desvincularResponsavel(@AlunoId id, @ResponsavelId resp);
            void definirPrincipal(@AlunoId id, @ResponsavelId resp);

            void editar(@Aluno alunoEditado);

            void validarAdicionarResponsavel(@Aluno aluno, @ResponsavelId responsavelId, boolean principal);

            void validarCadastro(String nome, LocalDate nascimento, @TurmaId turma, List<@ResponsavelId> responsaveis);

            void validarRemoverResponsavel(@Aluno aluno, @ResponsavelId responsavelId);

            void validarDefinirPrincipal(@Aluno aluno, @ResponsavelId responsavelId);

            void validarCadastroResponsaveis(List<@ResponsavelId> responsaveis, @ResponsavelId principal);
        }

        Service NotaService {
            void lancar(@AlunoId aluno, @SimuladoId simulado, @DisciplinaId disciplina, double valor);

            void lancarNota(@AlunoId alunoId, @SimuladoId simuladoId, @DisciplinaId disciplinaId, double valor);

            void retificarNota(@AlunoId alunoId, @SimuladoId simuladoId, @DisciplinaId disciplinaId, double novoValor, String justificativa, @ProfessorId professorId);

            void adicionarJustificativa(@AlunoId alunoId, @SimuladoId simuladoId, @DisciplinaId disciplinaId, String justificativa, @ProfessorId professorId);
        }

    }

    Aggregate Professor {
        Entity Professor {
            aggregateRoot

            -ProfessorId id
            String nome
            String cpf
            String enderecoEletronico
            List<String> especialidades

            def void atribuirIdSeAusente(@ProfessorId novoId);
            def void renomear(String novoNome);
            def void alterarEmail(String novoEmail);
            def void adicionarEspecialidade(String nomeArea);
            def void removerEspecialidade(String nomeArea);
            def boolean possuiEspecialidade(String nomeArea);

            Repository ProfessorRepository {
                @ProfessorId salvar(@Professor p);

                @Professor porId(@ProfessorId id);

                int contarTurmasAtivas(@ProfessorId id);              
                List<String> nomesDeAreasDoProfessor(@ProfessorId id); 
                boolean possuiSimuladoFinalizado(@ProfessorId id);     

                void substituirProfessor(@ProfessorId antigo, @ProfessorId substituto);
            }
        }

        ValueObject ProfessorId {
            int id
        }

        Service ProfessorService {
            @ProfessorId cadastrar(String nome, String cpf, String enderecoEletronico, List<String> especialidades);
            void atualizarContato(@ProfessorId id, String novoNome, String novoEmail);
            void validarLimiteDeTurmas(@ProfessorId id);
            void removerComSubstituto(@ProfessorId aRemover, @ProfessorId substituto);
            void adicionarEspecialidade(@ProfessorId id, String area);
            void removerEspecialidade(@ProfessorId id, String area);

            List<String> areasDoProfessor(@ProfessorId id);
        }
    }

    Aggregate Turma {

        ValueObject TurmaId {
            int id
        }

        Entity Turma {
            aggregateRoot

            -TurmaId id
            String nome
            int anoLetivo
            boolean ativo
            -ProfessorId professor

            def void atribuirIdSeAusente(@TurmaId novoId);
            def void renomear(String novoNome);
            def void mudarProfessor(@ProfessorId novoProfessor);

            def void inativar();
            def void ativar();

            def void alterarAnoLetivo(int novoAno);

            Repository TurmaRepository {
                @TurmaId salvar(@Turma t);

                @Turma porId(@TurmaId id);
                void remover(@TurmaId id);

                boolean existeNomeNoAno(String nome, int anoLetivo);
                boolean possuiAlunosAtivos(@TurmaId id);
                boolean possuiSimulados(@TurmaId id);
                boolean possuiSimuladosEmEdicao(@TurmaId id);
                boolean possuiSimuladosFinalizados(@TurmaId id);

                int anoLetivoDe(@TurmaId id);
            }
        }


        Service TurmaService {
            @TurmaId criar(String nome, int anoLetivo, @ProfessorId professor);
            @TurmaId criar(@Turma t);
            void renomear(@TurmaId id, String novoNome);
            void trocarProfessor(@TurmaId id, @ProfessorId novoProfessor);
            void inativar(@TurmaId id);
            void excluir(@TurmaId id);
        }
    }

    Aggregate Disciplina {
        Entity Disciplina {
            aggregateRoot

            -DisciplinaId id
            String nome
            int versao             
            Integer idVersaoOrigem  
            boolean ativo
            -AreaConhecimento area

            def void atribuirIdSeAusente(@DisciplinaId novoId);
            def void renomear(String novoNome);
            def void mudarArea(@AreaConhecimento novaArea);
            def void ativar();
            def void inativar();

            def @Disciplina novaVersao(String novoNome, @AreaConhecimento novaArea);

            Repository DisciplinaRepository {
                @DisciplinaId salvar(@Disciplina d);

                @Disciplina porId(@DisciplinaId id);
                void remover(@DisciplinaId id);

                boolean existeNomeNaArea(String nome, String areaNome);      
                boolean foiUsadaEmAlgumSimulado(@DisciplinaId id);            
                boolean foiUsadaEmSimuladoFinalizado(@DisciplinaId id);
            }
        }

        ValueObject DisciplinaId {
            int id
        }

        ValueObject AreaConhecimento {
            int id
            String nome
        }

        Service DisciplinaService {
            @DisciplinaId cadastrar(String nome, @AreaConhecimento area);
            void editar(@DisciplinaId id, String novoNome, @AreaConhecimento novaArea);
            void ativar(@DisciplinaId id);
            void inativar(@DisciplinaId id);
            void excluir(@DisciplinaId id);
        }
    }

    Aggregate Simulado {
        Entity Simulado {
            aggregateRoot

            -SimuladoId id
            LocalDate dataAplicacao
            -Status status      
            -TurmaId turma
            -List<DisciplinaPeso> disciplinas

            def void atribuirIdSeAusente(@SimuladoId novoId);
            def void alterarDisciplinas(List<@DisciplinaPeso> novas);
            def void alterarData(LocalDate novaData);
            def void finalizar();
            def void validarDisciplinas(List<@DisciplinaPeso> lista);

            Repository SimuladoRepository {
                @SimuladoId salvar(@Simulado s);

                @Simulado porId(@SimuladoId id);

                int contarEmEdicaoPorTurma(@TurmaId turmaId);
                List<@Simulado> listarPorTurma(@TurmaId turmaId);

                Map<Integer, Double> pesosDoSimulado(@SimuladoId id);

                boolean todasNotasLancadas(@SimuladoId id);
                
                void remover(@SimuladoId id);
            }
        }

        ValueObject SimuladoId {
            int id
        }

        ValueObject DisciplinaPeso {
            -DisciplinaId disciplina
            double peso
        }

        Service SimuladoService {
            @SimuladoId criar(LocalDate dataAplicacao, @TurmaId turma, List<@DisciplinaPeso> disciplinas);
            @SimuladoId criar(@Simulado s);
            void editarDisciplinas(@SimuladoId id, List<@DisciplinaPeso> novas);
            void finalizar(@SimuladoId id);
            void excluir(@SimuladoId id);
        }

        enum Status { 
            EM_EDICAO, 
            FINALIZADO 
        }
    }

    

    Aggregate Ranking {
        Entity Ranking {
            aggregateRoot

            -RankingId id
            -SimuladoId simulado
            boolean congelado
            -List<Linha> linhas;

            def void atribuirIdSeAusente(@RankingId id);
            def void substituirLinhas(List<@Linha> novas);
            def void congelar();

            Repository RankingRepository {
                void limpar(@SimuladoId simulado);

                void salvarPosicoes(@SimuladoId simulado, List<@Linha> linhas);

                void congelar(@SimuladoId simulado);

                boolean estaCongelado(@SimuladoId simulado);

                List<@Linha> carregar(@SimuladoId simulado);

                @Ranking salvar(@Ranking ranking);

                Optional<@Ranking> carregarAgregado(@SimuladoId simulado);
            }
        }

        ValueObject RankingId {
            int id
        }

        ValueObject Linha {
            -AlunoId aluno
            double media
            int posicao
        }

        Service RankingService {
            List<@Linha> recalcular(@SimuladoId simuladoId);
            @Ranking recalcularComoAgregado(@SimuladoId simuladoId);
            void congelar(@SimuladoId simuladoId);
            List<@Linha> calcularPosicoes(List<@Aluno> alunos, List<@Aluno> todosAlunos, Map<Integer, Double> pesos);
            double mediaPonderada(@Aluno aluno, List<Nota> notas, Map<Integer, Double> pesos);
        }
    }
}
