Domain QNota {
	Subdomain Academico
	Subdomain Avaliacao
}

ContextMap {
	contains Academico
	contains Avaliacao

	Academico Shared-Kernel Avaliacao
}

BoundedContext Academico implements Academico {

	Aggregate Aluno {
		Entity Aluno {
			aggregateRoot

			-AlunoId id
			String nome
			LocalDate dataNascimento
			boolean ativo
			-TurmaId turma
			List<ResponsavelId> responsaveis notEmpty
		}

		ValueObject AlunoId {
			int id
		}
	}

	Aggregate Responsavel {
		Entity Responsavel {
			aggregateRoot

			-ResponsavelId id
			String nome
			String cpf
			String email
		}

		ValueObject ResponsavelId {
			int id
		}
	}

	Aggregate Professor {
		Entity Professor {
			aggregateRoot

			-ProfessorId id
			String nome
			String cpf
			String email
		}

		ValueObject ProfessorId {
			int id
		}
	}

	Aggregate Turma {
		Entity Turma {
			aggregateRoot

			-TurmaId id
			String nome
			int anoLetivo
			boolean ativo
			ProfessorId professor
		}

		ValueObject TurmaId {
			int id
		}
	}
}

BoundedContext Avaliacao implements Avaliacao {

	Aggregate Simulado {
		Entity Simulado {
			aggregateRoot

			-SimuladoId id
			LocalDate dataAplicacao
			String status
			TurmaId turma
			List<DisciplinaPeso> disciplinas
		}

		ValueObject SimuladoId {
			int id
		}

		ValueObject DisciplinaPeso {
			DisciplinaId disciplina
			double peso
		}
	}

	Aggregate Disciplina {
		Entity Disciplina {
			aggregateRoot

			-DisciplinaId id
			String nome
		}

		ValueObject DisciplinaId {
			int id
		}
	}

	Aggregate Nota {
		Entity Nota {
			aggregateRoot

			-NotaId id
			AlunoId aluno
			SimuladoId simulado
			DisciplinaId disciplina
			double valor
		}

		ValueObject NotaId {
			int id
		}
	}

	Aggregate Justificativa {
		Entity Justificativa {
			aggregateRoot

			-JustificativaId id
			NotaId nota
			double notaAnterior
			double notaCorrigida
			String justificativa
			LocalDateTime dataHora
			ProfessorId professor
		}

		ValueObject JustificativaId {
			int id
		}
	}
}
