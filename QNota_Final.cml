Domain QNota {
    Subdomain Principal
}

ContextMap {
    contains Principal
}

BoundedContext Principal implements Principal {

    Aggregate Aluno {
        Entity Aluno {
            aggregateRoot

            -AlunoId id
            String nome
            LocalDate dataNascimento
            boolean ativo
            -TurmaId turma
            List<VinculoResponsavel> responsaveis notEmpty
        }

        ValueObject AlunoId {
            int id
        }

        ValueObject VinculoResponsavel {
            ResponsavelId responsavel
            String grauParentesco
            boolean principal
        }
    }

    Aggregate Responsavel {
        Entity Responsavel {
            aggregateRoot

            -ResponsavelId id
            String nome
            String cpf
            String email
            boolean inadimplente
        }

        ValueObject ResponsavelId {
            int id
        }
    }

    Aggregate Professor {
        Entity Professor {
            aggregateRoot

            -ProfessorId id
            String nome
            String cpf
            String email
            List<String> especialidades notEmpty
        }

        ValueObject ProfessorId {
            int id
        }
    }

    Aggregate Turma {
        Entity Turma {
            aggregateRoot

            -TurmaId id
            String nome
            int anoLetivo
            boolean ativo
            ProfessorId professor
        }

        ValueObject TurmaId {
            int id
        }
    }

    Aggregate Disciplina {
        Entity Disciplina {
            aggregateRoot

            -DisciplinaId id
            String nome
            String area
        }

        ValueObject DisciplinaId {
            int id
        }
    }

    Aggregate Simulado {
        Entity Simulado {
            aggregateRoot

            -SimuladoId id
            LocalDate dataAplicacao
            String status        // valores de uso: "EM_EDICAO" | "FINALIZADO"
            TurmaId turma
            List<DisciplinaPeso> disciplinas
        }

        ValueObject SimuladoId {
            int id
        }

        ValueObject DisciplinaPeso {
            DisciplinaId disciplina
            double peso
        }
    }

    Aggregate Nota {
        Entity Nota {
            aggregateRoot

            -NotaId id
            AlunoId aluno
            SimuladoId simulado
            DisciplinaId disciplina
            double valor
            LocalDateTime dataLancamento
        }

        ValueObject NotaId {
            int id
        }
    }

    Aggregate Justificativa {
        Entity Justificativa {
            aggregateRoot

            -JustificativaId id
            NotaId nota
            double notaAnterior
            double notaCorrigida
            String justificativa
            LocalDateTime dataHora
            ProfessorId professor
        }

        ValueObject JustificativaId {
            int id
        }
    }
}
